def main() -> None:
    try:
        action = sys.argv[1]
    except IndexError:
        sys.stderr.write(
            "× CRIT: action is not specified. Should be `repo-to-home` "
            "or `home-to-repo`\n"
        )
        sys.exit(1)

    if action not in {"repo-to-home", "home-to-repo"}:
        sys.stderr.write(
            f"× CRIT: unknown action `{action}`. Should be `repo-to-home` "
            "or `home-to-repo`\n"
        )
        sys.exit(1)

    try:
        file_selector = sys.argv[2]
    except IndexError:
        sys.stderr.write(
            "× CRIT: file is not specified. Should be a configured path "
            f"relative to home or `{ALL_FILES}`\n"
        )
        sys.exit(1)

    files = select_config_files(file_selector)
    loaded_variables = load_variables()
    ui_scale = load_ui_scale(loaded_variables)
    variables = {name: str(value) for name, value in loaded_variables.items()}

    if action == "repo-to-home":
        if file_selector == ALL_FILES:
            ensure_directories()
        render_files(files, variables, ui_scale)
        run_post_install_hook()
    else:
        de_render_files(files, variables, ui_scale)


def run_post_install_hook() -> None:
    post_install_path = REPO_ROOT / "hooks" / "post-install"
    if not post_install_path.exists():
        return

    sys.stderr.write(f"× INFO: running post-install hook\n")
    subprocess.run([str(post_install_path)], check=True)


def select_config_files(file_selector: str) -> list[Config]:
    if file_selector == ALL_FILES:
        return CONFIG_FILES

    host_path = Path(file_selector).expanduser()
    if not host_path.is_absolute():
        host_path = HOST_ROOT / host_path

    files = [file for file in CONFIG_FILES if file.host_path == host_path]
    if not files:
        sys.stderr.write(
            f"× CRIT: unknown file `{file_selector}`. Should be a configured "
            f"path relative to home or `{ALL_FILES}`\n"
        )
        sys.exit(1)

    return files


def ensure_directories() -> None:
    for directory in DIRECTORIES:
        _ = sys.stderr.write(
            f"× INFO: ensure directory {directory.path} exists\n"
        )
        directory.ensure()


def de_render_files(
    files: list[Config],
    variables: dict[str, str],
    ui_scale: Decimal,
) -> None:
    for file in files:
        de_render(file, variables, ui_scale)


def render_files(
    files: list[Config],
    variables: dict[str, str],
    ui_scale: Decimal,
) -> None:
    for file in files:
        render(file, variables, ui_scale)


def load_settings() -> dict[str, Any]:
    settings_path = REPO_ROOT / "settings.toml"

    with settings_path.open("rb") as settings_file:
        settings = tomllib.load(settings_file)

    return settings


def load_variables() -> dict[str, Any]:
    settings = load_settings()
    colors = settings.get("colors", {})

    builtins = {
        "home": str(Path.home()),
        "repo": str(REPO_ROOT),
    }

    hostname = os.uname().nodename if not OS_IS_TERMUX else "termux"
    host_overrides = settings.get("hosts", {}).get(hostname, {})

    return {
        **colors,
        **builtins,
        **host_overrides,
    }


def load_ui_scale(variables: dict[str, Any]) -> Decimal:
    raw_ui_scale = variables.pop("ui_scale", 1)

    try:
        ui_scale = Decimal(str(raw_ui_scale))
    except InvalidOperation:
        critical(f"ui_scale `{raw_ui_scale}` is not a number")

    if not ui_scale.is_finite() or ui_scale <= 0:
        critical(f"ui_scale `{raw_ui_scale}` should be greater than zero")

    return ui_scale


def render(
    file: Config,
    variables: dict[str, str],
    ui_scale: Decimal,
) -> None:
    sys.stderr.write(f"× INFO: render {file.repo_path} to {file.host_path}\n")

    file.host_path.parent.mkdir(parents=True, exist_ok=True)

    # Load original file
    with file.repo_path.open("r") as repo_file:
        original_data = repo_file.read()

    # Render template
    if file.templated:
        template = Template(original_data)
        config_data = template.safe_substitute(**variables)
    else:
        config_data = original_data

    config_data = render_scaled_values(
        config_data,
        ui_scale,
        file.repo_path,
    )

    # Write final config
    with file.host_path.open("w") as host_file:
        host_file.write(config_data)

    # Ensure file mode
    if file.mode is not None:
        file.host_path.chmod(file.mode)


def de_render(
    file: Config,
    variables: dict[str, str],
    ui_scale: Decimal,
) -> None:
    """
    Copies file from host back to config directory
    """

    if not file.host_path.exists():
        sys.stderr.write(
            f"× WARNING: file {file.host_path} doesn't exist. Skipping\n"
        )

        return

    sys.stderr.write(
        f"× INFO: de-render {file.host_path} to {file.repo_path}\n"
    )

    file.repo_path.parent.mkdir(parents=True, exist_ok=True)

    # shutil.copy(file.host_path, file.repo_path)

    with file.host_path.open("r") as host_file:
        config = host_file.read()

    config = de_render_scaled_values(
        config,
        ui_scale,
        file.host_path,
    )

    if file.templated:
        config = un_template_config(config, variables)

    with file.repo_path.open("w") as repo_file:
        repo_file.write(config)


def render_scaled_values(
    config: str,
    ui_scale: Decimal,
    config_path: Path,
) -> str:
    rendered_lines = []
    pending_scale: tuple[int, list[str]] | None = None

    for line_number, line in enumerate(
        config.splitlines(keepends=True),
        start=1,
    ):
        base_values = SCALE_EXPRESSION_PATTERN.findall(line)
        comment_match = SCALE_COMMENT_PATTERN.search(line)
        directive_match = SCALE_DIRECTIVE_PATTERN.match(line)

        if pending_scale is not None:
            rendered_lines.append(
                render_scale_directive_target(
                    line,
                    pending_scale,
                    ui_scale,
                    config_path,
                    line_number,
                )
            )
            pending_scale = None
            continue

        if directive_match is not None:
            rendered_lines.append(line)
            pending_scale = (
                line_number,
                parse_scale_comment(directive_match),
            )
            continue

        if not base_values:
            if comment_match is not None:
                scale_error(
                    config_path,
                    line_number,
                    "`SCALE:` comment has no `@scale(...)` expressions",
                )

            rendered_lines.append(line)
            continue

        if comment_match is None:
            scale_error(
                config_path,
                line_number,
                "scaled line has no `SCALE:` comment",
            )

        comment_values = parse_scale_comment(comment_match)
        if base_values != comment_values:
            scale_error(
                config_path,
                line_number,
                f"scale expressions {base_values} do not match "
                f"comment values {comment_values}",
            )

        rendered_lines.append(
            SCALE_EXPRESSION_PATTERN.sub(
                lambda match: scale_value(match.group(1), ui_scale),
                line,
            )
        )

    if pending_scale is not None:
        directive_line_number, _ = pending_scale
        scale_error(
            config_path,
            directive_line_number,
            "standalone `SCALE:` directive is at end of file",
        )

    return "".join(rendered_lines)


def de_render_scaled_values(
    config: str,
    ui_scale: Decimal,
    config_path: Path,
) -> str:
    de_rendered_lines = []
    pending_scale: tuple[int, list[str]] | None = None

    for line_number, line in enumerate(
        config.splitlines(keepends=True),
        start=1,
    ):
        comment_match = SCALE_COMMENT_PATTERN.search(line)
        directive_match = SCALE_DIRECTIVE_PATTERN.match(line)
        expression_values = SCALE_EXPRESSION_PATTERN.findall(line)

        if pending_scale is not None:
            de_rendered_lines.append(
                de_render_scale_directive_target(
                    line,
                    pending_scale,
                    ui_scale,
                    config_path,
                    line_number,
                )
            )
            pending_scale = None
            continue

        if directive_match is not None:
            de_rendered_lines.append(line)
            pending_scale = (
                line_number,
                parse_scale_comment(directive_match),
            )
            continue

        if comment_match is None:
            de_rendered_lines.append(line)
            continue

        base_values = parse_scale_comment(comment_match)
        if expression_values:
            if expression_values != base_values:
                scale_error(
                    config_path,
                    line_number,
                    f"scale expressions {expression_values} do not match "
                    f"comment values {base_values}",
                )

            de_rendered_lines.append(line)
            continue

        before_comment = line[: comment_match.start()]
        after_comment = line[comment_match.start() :]
        restored_before_comment = restore_scaled_values_in_text(
            before_comment,
            base_values,
            config_path,
            line_number,
            ui_scale,
        )
        de_rendered_lines.append(restored_before_comment + after_comment)

    if pending_scale is not None:
        directive_line_number, _ = pending_scale
        scale_error(
            config_path,
            directive_line_number,
            "standalone `SCALE:` directive is at end of file",
        )

    return "".join(de_rendered_lines)


def render_scale_directive_target(
    line: str,
    directive: tuple[int, list[str]],
    ui_scale: Decimal,
    config_path: Path,
    line_number: int,
) -> str:
    directive_line_number, directive_values = directive
    base_values = validate_scale_directive_target(
        line,
        config_path,
        directive_line_number,
        line_number,
    )

    if not base_values:
        scale_error(
            config_path,
            line_number,
            "line after standalone `SCALE:` directive has no "
            "`@scale(...)` expressions",
        )

    if base_values != directive_values:
        scale_error(
            config_path,
            line_number,
            f"scale expressions {base_values} do not match "
            f"standalone directive values {directive_values}",
        )

    return SCALE_EXPRESSION_PATTERN.sub(
        lambda match: scale_value(match.group(1), ui_scale),
        line,
    )


def de_render_scale_directive_target(
    line: str,
    directive: tuple[int, list[str]],
    ui_scale: Decimal,
    config_path: Path,
    line_number: int,
) -> str:
    directive_line_number, directive_values = directive
    expression_values = validate_scale_directive_target(
        line,
        config_path,
        directive_line_number,
        line_number,
    )

    if expression_values:
        if expression_values != directive_values:
            scale_error(
                config_path,
                line_number,
                f"scale expressions {expression_values} do not match "
                f"standalone directive values {directive_values}",
            )

        return line

    return restore_scaled_values_in_text(
        line,
        directive_values,
        config_path,
        line_number,
        ui_scale,
    )


def validate_scale_directive_target(
    line: str,
    config_path: Path,
    directive_line_number: int,
    line_number: int,
) -> list[str]:
    if (
        SCALE_DIRECTIVE_PATTERN.match(line) is not None
        or not line.strip()
        or line.lstrip().startswith(("#", "//"))
    ):
        scale_error(
            config_path,
            directive_line_number,
            "standalone `SCALE:` directive must be immediately "
            "followed by a config line",
        )

    if SCALE_COMMENT_PATTERN.search(line) is not None:
        scale_error(
            config_path,
            line_number,
            "scaled line cannot have both standalone and inline "
            "`SCALE:` annotations",
        )

    return SCALE_EXPRESSION_PATTERN.findall(line)


def restore_scaled_values_in_text(
    text: str,
    base_values: list[str],
    config_path: Path,
    line_number: int,
    ui_scale: Decimal,
) -> str:
    restored_parts = []
    cursor = 0

    for base_value in base_values:
        rendered_value = scale_value(base_value, ui_scale)
        rendered_value_pattern = re.compile(
            rf"(?<![\d.]){re.escape(rendered_value)}(?![\d.])"
        )
        rendered_value_match = rendered_value_pattern.search(text, cursor)

        if rendered_value_match is None:
            scale_error(
                config_path,
                line_number,
                f"expected rendered value `{rendered_value}` for "
                f"base value `{base_value}`",
            )

        restored_parts.append(text[cursor : rendered_value_match.start()])
        restored_parts.append(f"@scale({base_value})")
        cursor = rendered_value_match.end()

    restored_parts.append(text[cursor:])
    return "".join(restored_parts)


def parse_scale_comment(comment_match: re.Match[str]) -> list[str]:
    return [value.strip() for value in comment_match.group(1).split(",")]


def scale_value(value: str, ui_scale: Decimal) -> str:
    scaled_value = Decimal(value) * ui_scale
    rounded_value = scaled_value.quantize(
        Decimal(1),
        rounding=ROUND_HALF_UP,
    )

    return str(rounded_value)


def scale_error(
    config_path: Path,
    line_number: int,
    message: str,
) -> NoReturn:
    critical(f"{config_path}:{line_number}: {message}")


def critical(message: str) -> NoReturn:
    sys.stderr.write(f"× CRIT: {message}\n")
    raise SystemExit(1)


def un_template_config(
    config: str,
    variables: dict[str, str],
) -> str:
    """
    Replaces values in rendered config with template placeholders
    """

    # NOTE: we need to sort variables by length to avoid replacing
    #       shorter values that are substrings of longer values first
    sorted_variables = sorted(
        variables.items(),
        key=lambda item: len(item[1]),
        reverse=True,
    )

    placeholders = {}
    for name, value in sorted_variables:
        if not value:
            continue

        placeholders[value] = f"${{{name}}}"

    config = config.replace("$", "$$")
    for value, placeholder in placeholders.items():
        config = config.replace(value, placeholder)

    return config


if __name__ == "__main__":
    main()
