def main() -> None:
    try:
        action = sys.argv[1]
    except IndexError:
        sys.stderr.write(
            "× CRIT: action is not specified. Should be `repo-to-home` "
            "or `home-to-repo`\n"
        )
        sys.exit(1)

    if action not in {"repo-to-home", "home-to-repo"}:
        sys.stderr.write(
            f"× CRIT: unknown action `{action}`. Should be `repo-to-home` "
            "or `home-to-repo`\n"
        )
        sys.exit(1)

    try:
        file_selector = sys.argv[2]
    except IndexError:
        sys.stderr.write(
            "× CRIT: file is not specified. Should be a configured path "
            f"relative to home or `{ALL_FILES}`\n"
        )
        sys.exit(1)

    files = select_config_files(file_selector)
    loaded_variables = load_variables()
    ui_scale = load_ui_scale(loaded_variables)
    variables = {name: str(value) for name, value in loaded_variables.items()}

    if action == "repo-to-home":
        if file_selector == ALL_FILES:
            ensure_directories()
        render_files(files, variables, ui_scale)
        run_post_install_hook()
    else:
        derender_files(files, variables, ui_scale)


def run_post_install_hook() -> None:
    post_install_path = REPO_ROOT / "hooks" / "post-install"
    if not post_install_path.exists():
        return

    sys.stderr.write(f"× INFO: running post-install hook\n")
    subprocess.run([str(post_install_path)], check=True)


def select_config_files(file_selector: str) -> list[Config]:
    if file_selector == ALL_FILES:
        return CONFIG_FILES

    host_path = Path(file_selector).expanduser()
    if not host_path.is_absolute():
        host_path = HOST_ROOT / host_path

    files = [file for file in CONFIG_FILES if file.host_path == host_path]
    if not files:
        sys.stderr.write(
            f"× CRIT: unknown file `{file_selector}`. Should be a configured "
            f"path relative to home or `{ALL_FILES}`\n"
        )
        sys.exit(1)

    return files


def ensure_directories() -> None:
    for directory in DIRECTORIES:
        _ = sys.stderr.write(
            f"× INFO: ensure directory {directory.path} exists\n"
        )
        directory.ensure()


def derender_files(
    files: list[Config],
    variables: dict[str, str],
    ui_scale: Decimal,
) -> None:
    for file in files:
        derender_one_file(file, variables, ui_scale)


def render_files(
    files: list[Config],
    variables: dict[str, str],
    ui_scale: Decimal,
) -> None:
    for file in files:
        render(file, variables, ui_scale)


def load_settings() -> dict[str, Any]:
    settings_path = REPO_ROOT / "settings.toml"

    with settings_path.open("rb") as settings_file:
        settings = tomllib.load(settings_file)

    return settings


def load_variables() -> dict[str, Any]:
    settings = load_settings()
    fonts = {
        "font_name": settings["font_name"],
        "extra_font_name": settings["extra_font_name"],
    }
    colors = settings.get("colors", {})

    builtins = {
        "home": str(Path.home()),
        "repo": str(REPO_ROOT),
    }

    hostname = os.uname().nodename if not OS_IS_TERMUX else "termux"
    host_overrides = settings.get("hosts", {}).get(hostname, {})

    return {
        **fonts,
        **colors,
        **builtins,
        **host_overrides,
    }


def load_ui_scale(variables: dict[str, Any]) -> Decimal:
    raw_ui_scale = variables.pop("ui_scale", 1)

    try:
        ui_scale = Decimal(str(raw_ui_scale))
    except InvalidOperation:
        critical(f"ui_scale `{raw_ui_scale}` is not a number")

    if not ui_scale.is_finite() or ui_scale <= 0:
        critical(f"ui_scale `{raw_ui_scale}` should be greater than zero")

    return ui_scale


def render(
    file: Config,
    variables: dict[str, str],
    ui_scale: Decimal,
) -> None:
    sys.stderr.write(f"× INFO: render {file.repo_path} to {file.host_path}\n")

    file.host_path.parent.mkdir(parents=True, exist_ok=True)

    # Load original file
    with file.repo_path.open("r") as repo_file:
        original_text = repo_file.read()

    # Render template
    if file.templated:
        rendered_text = render_template(original_text, variables, ui_scale)
    else:
        rendered_text = original_text

    # Write final config
    with file.host_path.open("w") as host_file:
        host_file.write(rendered_text)

    # Ensure file mode
    if file.mode is not None:
        file.host_path.chmod(file.mode)


class Replacer(Protocol):
    @staticmethod
    def match_template(
        line: str,
        variables: dict[str, str],
        ui_scale: Decimal,
    ) -> Replacer | None:
        pass


class VarReplacer:
    # VAR: name
    RENDER_PATTERN = re.compile(r"VAR: (\w+)")

    # VAR: name -> value
    DERENDER_PATTERN = re.compile(r"VAR: (\w+) -> (.+)")

    def __init__(
        self,
        line: str,
        name: str,
        value: str,
    ) -> None:
        self.line = line
        self.name = name
        self.value = value

    @staticmethod
    def match_template(
        line: str,
        variables: dict[str, str],
    ) -> VarReplacer | None:
        match = VarReplacer.RENDER_PATTERN.search(line)
        if not match:
            return None

        name = match.group(1)

        return VarReplacer(
            line=line,
            name=name,
            value=variables[name],
        )

    @staticmethod
    def match_config(
        line: str,
        variables: dict[str, str],
    ) -> VarReplacer | None:
        match = VarReplacer.DERENDER_PATTERN.search(line)
        if not match:
            return None

        name = match.group(1)
        value = match.group(2)

        return VarReplacer(
            line=line,
            name=name,
            value=value,
        )

    def self_render(
        self,
    ) -> str:
        return self.line.replace(
            self.name,
            f"{self.name} -> {self.value}",
            count=1,
        )

    def line_render(
        self,
        line: str,
    ) -> str:
        assert f"{{{self.name}}}" in line, (
            f"Variable {self.name} not found in line: {line}"
        )
        return line.replace(f"{{{self.name}}}", self.value, count=1)

    def self_derender(
        self,
    ) -> str:
        return self.line.replace(f" -> {self.value}", "", count=1)

    def line_derender(
        self,
        line: str,
    ) -> str:
        assert self.value in line, (
            f"Value {self.value} not found in line: {line}"
        )
        return line.replace(self.value, f"{{{self.name}}}", count=1)


class ScaleReplacer:
    # SCALE: base value [(decimal count)]
    RENDER_PATTERN = re.compile(r"SCALE: ([\d.]+)\s*(\((\d+)\))?")

    # SCALE: base value -> rendered value [(decimal count)]
    DERENDER_PATTERN = re.compile(r"SCALE: ([\d.]+) -> ([\d.]+)\s*(\((\d+)\))?")

    def __init__(
        self,
        line: str,
        base_value: Decimal,
        decimal_count: int | None,
        scaled_value: Decimal,
    ) -> None:
        self.line = line
        self.base_value = base_value
        self.decimal_count = decimal_count
        self.scaled_value = scaled_value

    @staticmethod
    def scale(
        base_value: Decimal,
        ui_scale: Decimal,
        decimal_count: int | None = None,
    ) -> Decimal:
        scaled_value = base_value * ui_scale

        if decimal_count is not None:
            quantize_str = "1." + "0" * decimal_count
            scaled_value = scaled_value.quantize(
                Decimal(quantize_str), rounding=ROUND_HALF_UP
            )

        return scaled_value

    @staticmethod
    def match_template(
        line: str,
        ui_scale: Decimal,
    ) -> ScaleReplacer | None:
        match = ScaleReplacer.RENDER_PATTERN.search(line)
        if not match:
            return None

        base_value = match.group(1)
        decimal_count = match.group(3) or 0
        scaled_value = ScaleReplacer.scale(
            base_value=Decimal(base_value),
            ui_scale=ui_scale,
            decimal_count=int(decimal_count),
        )

        return ScaleReplacer(
            line=line,
            base_value=base_value,
            decimal_count=int(decimal_count),
            scaled_value=scaled_value,
        )

    @staticmethod
    def match_config(
        line: str,
        ui_scale: Decimal,
    ) -> ScaleReplacer | None:
        _ = ui_scale

        match = ScaleReplacer.DERENDER_PATTERN.search(line)
        if not match:
            return None

        base_value = match.group(1)
        scaled_value = match.group(2)
        decimal_count = match.group(4) or 0

        return ScaleReplacer(
            line=line,
            base_value=base_value,
            decimal_count=int(decimal_count),
            scaled_value=scaled_value,
        )

    def self_render(
        self,
    ) -> str:
        return self.line.replace(
            str(self.base_value),
            f"{self.base_value} -> {self.scaled_value}",
            count=1,
        )

    def line_render(
        self,
        line: str,
    ) -> str:
        assert f"{{{self.base_value}}}" in line, (
            f"Base value {self.base_value} not found in line: {line}"
        )

        return line.replace(
            f"{{{self.base_value}}}",
            str(self.scaled_value),
            count=1,
        )

    def self_derender(
        self,
    ) -> str:
        return self.line.replace(
            f" -> {self.scaled_value}",
            "",
            count=1,
        )

    def line_derender(
        self,
        line: str,
    ) -> str:
        assert str(self.scaled_value) in line, (
            f"Scaled value {self.scaled_value} not found in line: {line}"
        )

        return line.replace(
            str(self.scaled_value),
            f"{{{self.base_value}}}",
            count=1,
        )


def render_template(
    text: str,
    variables: dict[str, str],
    ui_scale: Decimal,
) -> str:
    result_lines: list[str] = []
    replacers: list[Replacer] = []

    for line in text.splitlines(keepends=True):
        if replacer := VarReplacer.match_template(line, variables):
            replacers.append(replacer)
            result_lines.append(replacer.self_render())
        elif replacer := ScaleReplacer.match_template(line, ui_scale):
            replacers.append(replacer)
            result_lines.append(replacer.self_render())
        else:
            for replacer in replacers:
                line = replacer.line_render(line)

            result_lines.append(line)

            replacers = []

    return "".join(result_lines)


def derender_template(
    text: str,
    variables: dict[str, str],
    ui_scale: Decimal,
) -> str:
    result_lines: list[str] = []
    replacers: list[Replacer] = []

    for line in text.splitlines(keepends=True):
        if replacer := VarReplacer.match_config(line, variables):
            replacers.append(replacer)
            result_lines.append(replacer.self_derender())
        elif replacer := ScaleReplacer.match_config(line, ui_scale):
            replacers.append(replacer)
            result_lines.append(replacer.self_derender())
        else:
            for replacer in replacers:
                line = replacer.line_derender(line)

            result_lines.append(line)

            replacers = []

    return "".join(result_lines)


def derender_one_file(
    file: Config,
    variables: dict[str, str],
    ui_scale: Decimal,
) -> None:
    """
    Copies file from host back to config directory
    """

    if not file.host_path.exists():
        sys.stderr.write(
            f"× WARNING: file {file.host_path} doesn't exist. Skipping\n"
        )

        return

    sys.stderr.write(
        f"× INFO: de-render {file.host_path} to {file.repo_path}\n"
    )

    file.repo_path.parent.mkdir(parents=True, exist_ok=True)

    with file.host_path.open("r") as host_file:
        config_text = host_file.read()

    if file.templated:
        config_text = derender_template(config_text, variables, ui_scale)

    with file.repo_path.open("w") as repo_file:
        repo_file.write(config_text)


def critical(message: str) -> NoReturn:
    sys.stderr.write(f"× CRIT: {message}\n")
    raise SystemExit(1)


if __name__ == "__main__":
    main()
