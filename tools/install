#!/usr/bin/env python

import os
import re
import shutil
import subprocess
import sys
import tomllib
from dataclasses import dataclass
from decimal import ROUND_HALF_UP, Decimal, InvalidOperation
from pathlib import Path
from string import Template
from typing import Any, NoReturn, Self

HOST_ROOT: Path = Path.home()
REPO_ROOT: Path = Path(__file__).parent.parent
CONFIG_ROOT: Path = REPO_ROOT / "config"

OS_IS_TERMUX = "com.termux" in os.environ.get("PREFIX", "")

ALL_FILES = "ALL"

SCALE_NUMBER_PATTERN = r"-?(?:\d+(?:\.\d+)?|\.\d+)"
SCALE_EXPRESSION_PATTERN = re.compile(rf"@scale\(({SCALE_NUMBER_PATTERN})\)")
SCALE_COMMENT_PATTERN = re.compile(
    rf"\bSCALE:\s*((?:{SCALE_NUMBER_PATTERN}\s*,\s*)*"
    rf"{SCALE_NUMBER_PATTERN})"
)
SCALE_DIRECTIVE_PATTERN = re.compile(
    rf"^\s*(?:#|//)\s*SCALE:\s*"
    rf"((?:{SCALE_NUMBER_PATTERN}\s*,\s*)*{SCALE_NUMBER_PATTERN})\s*$"
)


@dataclass
class Config:
    host_path: Path  # path in home directory
    repo_path: Path  # path `dotfiles/config` directory
    templated: bool
    mode: int | None

    @classmethod
    def home(
        cls: type[Self],
        host_path: str,
        repo_path: str,
        templated: bool = False,
        mode: int | None = None,
    ) -> Self:
        return cls(
            host_path=HOST_ROOT / host_path,
            repo_path=CONFIG_ROOT / repo_path,
            templated=templated,
            mode=mode,
        )


@dataclass
class Directory:
    path: Path
    mode: int

    @classmethod
    def home(
        cls: type[Self],
        partial_path: str,
        mode: int = 0o755,
    ) -> Self:
        return cls(
            path=HOST_ROOT / partial_path,
            mode=mode,
        )

    def ensure(self) -> None:
        self.path.mkdir(parents=True, exist_ok=True, mode=self.mode)
        self.path.chmod(self.mode)


DIRECTORIES = [
    Directory.home(".ssh/control", mode=0o700),
    Directory.home("downloads"),
]


