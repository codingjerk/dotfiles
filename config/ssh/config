# vim: set ft=sshconfig

# Less keepalive packets on battery power
Match exec "! systemd-ac-power"
    ServerAliveInterval 30
    ServerAliveCountMax 3
    ControlPersist 5m
    TCPKeepAlive no

Host *.cj.dog
    User cj

Host voyager
    Port 2206

Host *
    # If user is unspecified, connect as root
    User root

    ExitOnForwardFailure yes

    # Security
    StrictHostKeyChecking accept-new
    HashKnownHosts yes
    AddKeysToAgent yes

    # Network options
    ConnectTimeout 5
    ConnectionAttempts 3

    Compression yes
    IPQoS lowdelay
    AddressFamily inet

    # Multiplexing
    ControlMaster auto
    ControlPersist 30m
    ControlPath ~/.ssh/control/%h-%C

    # Keepalive
    TCPKeepAlive yes
    ServerAliveInterval 3
    ServerAliveCountMax 20
