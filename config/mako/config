# vi: ft=dosini

# SCALE: 9
font=Noto Sans Mono Light @scale(9)

max-history=0
ignore-timeout=1
default-timeout=5000
max-visible=10

# SCALE: 350
width=@scale(350)
# SCALE: 100
height=@scale(100)
anchor=top-right
# SCALE: 16
outer-margin=@scale(16)
# SCALE: 12
margin=@scale(12)
# SCALE: 16
padding=@scale(16)
format=%s\n%b

background-color=#${bg_dim_more}
text-color=#${fg}
progress-color=over #${purple}90

# SCALE: 12
border-radius=@scale(12)
border-size=0

group-by=summary

[urgency=critical]
  default-timeout=0
  border-color=#${red}
  # SCALE: 1.5
  border-size=@scale(1.5)

[category=volume]
  group-by=category
  default-timeout=1500
  # SCALE: 16
  padding=0,@scale(16)

[grouped category=volume]
  format=%s\n%b

[category=mic]
  group-by=category
  default-timeout=1500
  # SCALE: 16
  padding=0,@scale(16)

[grouped category=mic]
  format=%s\n%b

[category=brightness]
  group-by=category
  default-timeout=1500
  # SCALE: 16
  padding=0,@scale(16)

[grouped category=brightness]
  format=%s\n%b

[category=media]
  group-by=category
  default-timeout=1500
  # SCALE: 16, 16
  padding=@scale(16),@scale(16)

[grouped category=media]
  format=%s\n%b

[category=battery]
  group-by=category
  format=<span foreground="#${red}">%s</span>\n%b
  progress-color=over #${fg_dim}A0

[grouped category=battery]
  format=<span foreground="#${red}">%s</span>\n%b

[category=disk]
  group-by=category
  format=<span foreground="#${red}">%s</span>\n%b
  progress-color=over #${fg_dim}A0

[grouped category=disk]
  format=<span foreground="#${red}">%s</span>\n%b
