font=Noto Sans Mono Light 11

max-history=0
ignore-timeout=1
default-timeout=5000
max-visible=20

width=450
height=200
anchor=top-right
outer-margin=0
margin=12
padding=24
format=%s\n%b

background-color=#${bg_dim_more}
text-color=#${fg}
progress-color=over #${pink}A0

border-radius=16
border-size=0

group-by=summary

[urgency=critical]
default-timeout=0

[category=volume]
group-by=category
default-timeout=1500
height=50
width=500
padding=0,32

[grouped category=volume]
format=%s\n%b

[category=mic]
group-by=category
default-timeout=1500
height=50
width=500
padding=0,32

[grouped category=mic]
format=%s\n%b

[category=brightness]
group-by=category
default-timeout=1500
height=50
width=500
padding=0,32

[grouped category=brightness]
format=%s\n%b

[category=media]
group-by=category
default-timeout=1500
height=50
width=500
padding=0,32

[grouped category=media]
format=%s\n%b

[category=battery]
group-by=category
width=700
padding=32,32
format=<span foreground="#${red}">%s</span>\n%b
progress-color=over #${fg_dim}A0
border-size=3
border-color=#${red}

[grouped category=battery]
format=<span foreground="#${red}">%s</span>\n%b

[category=disk]
group-by=category
width=700
padding=32,32
format=<span foreground="#${red}">%s</span>\n%b
progress-color=over #${fg_dim}A0
border-size=3
border-color=#${red}

[grouped category=disk]
format=<span foreground="#${red}">%s</span>\n%b

[category=systemd]
group-by=category
width=700
padding=32,32

[grouped category=systemd]
format=%s\n%b

[category=network]
group-by=category
width=700
padding=32,32

[grouped category=network]
format=%s\n%b

[category=break]
group-by=category
anchor=center
width=700
padding=32,32

[grouped category=break]
format=%s\n%b

[category=remind]
group-by=category
width=700
padding=32,32

[grouped category=remind]
format=%s\n%b
