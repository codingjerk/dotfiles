# vi: ft=dosini

# VAR: font_name
# VAR: text_font_size
font={font_name} {text_font_size}px

max-history=0
ignore-timeout=1
default-timeout=5000
max-visible=10

# SCALE: 466.5
width={466.5}
# SCALE: 166.5
height={166.5}
anchor=top-right
# SCALE: 16
outer-margin={16}
# SCALE: 12
margin={12}
# SCALE: 16
padding={16}
format=%s\n%b

# VAR: bg_dim_more
background-color=#{bg_dim_more}
# VAR: fg
text-color=#{fg}
# VAR: purple
progress-color=over #{purple}90

# SCALE: 12
border-radius={12}
# NOTE: border with color closed to the background to imitate shadow
# SCALE: 1.5
border-size={1.5}
# VAR: bg_dim
border-color=#{bg_dim}

group-by=summary

[urgency=critical]
  default-timeout=0
  # VAR: red
  border-color=#{red}
  # VAR: bg_remove
  background-color=#{bg_remove}

[category=volume]
  group-by=category
  default-timeout=1500
  # SCALE: 8
  # SCALE: 16
  padding={8},{16}
  # SCALE: 16
  border-radius={16}
  # SCALE: 333.3
  width={333.3}

[grouped category=volume]
  format=%s\n%b

[category=mic]
  group-by=category
  default-timeout=1500
  # SCALE: 8
  # SCALE: 16
  padding={8},{16}
  # SCALE: 16
  border-radius={16}
  # SCALE: 333.3
  width={333.3}

[grouped category=mic]
  format=%s\n%b

[category=brightness]
  group-by=category
  default-timeout=1500
  # SCALE: 8
  # SCALE: 16
  padding={8},{16}
  # SCALE: 16
  border-radius={16}
  # SCALE: 333.3
  width={333.3}

[grouped category=brightness]
  format=%s\n%b

[category=media]
  group-by=category
  default-timeout=1500
  # SCALE: 16
  # SCALE: 16
  padding={16},{16}

[grouped category=media]
  format=%s\n%b

[category=battery]
  group-by=category
  # VAR: red
  format=<span foreground="#{red}">%s</span>\n%b
  # VAR: red
  progress-color=over #{red}70

[grouped category=battery]
  # VAR: red
  format=<span foreground="#{red}">%s</span>\n%b

[category=battery-charging]
  group-by=category
  # VAR: green
  format=<span foreground="#{green}">%s</span>\n%b
  # VAR: green
  progress-color=over #{green}70
  # VAR: bg_add
  background-color=#{bg_add}

[grouped category=battery-charging]
  # VAR: green
  format=<span foreground="#{green}">%s</span>\n%b

[category=battery-warning]
  group-by=category
  # VAR: orange
  format=<span foreground="#{orange}">%s</span>\n%b
  # VAR: orange
  progress-color=over #{orange}70
  # TODO: orange_bg
  background-color=#332e21

[grouped category=battery-warning]
  # VAR: green
  format=<span foreground="#{green}">%s</span>\n%b

[category=disk]
  group-by=category
  # VAR: red
  format=<span foreground="#{red}">%s</span>\n%b
  # VAR: fg_dim
  progress-color=over #{fg_dim}A0
  default-timeout=0

[grouped category=disk]
  # VAR: red
  format=<span foreground="#{red}">%s</span>\n%b
  default-timeout=0

[category=remind]
  anchor=center
  # VAR: blue
  border-color=#{blue}
  default-timeout=0

[category=break]
  anchor=center
  # VAR: blue
  border-color=#{blue}
  # If I don't notice it, then I'm probably AFK, so let's hide it eventually
  default-timeout=50000

[category=lock-notification]
  anchor=center
  default-timeout=50000
